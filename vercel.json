{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bun run build",
  "outputDirectory": ".output/public",
  "installCommand": "bun install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/agent", "destination": "/api/agent" },
    { "source": "/api/builder", "destination": "/api/builder" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/critique", "destination": "/api/critique" },
    { "source": "/api/embed", "destination": "/api/embed" },
    { "source": "/api/find-video", "destination": "/api/find-video" },
    { "source": "/api/free-chat", "destination": "/api/free-chat" },
    { "source": "/api/fx", "destination": "/api/fx" },
    { "source": "/api/generate-image", "destination": "/api/generate-image" },
    { "source": "/api/read-page", "destination": "/api/read-page" },
    { "source": "/api/realtime-session", "destination": "/api/realtime-session" },
    { "source": "/api/transcribe", "destination": "/api/transcribe" },
    { "source": "/api/web-search", "destination": "/api/web-search" },
    { "source": "/((?!api/|assets/|_build/|favicon\\.ico|robots\\.txt|sitemap\\.xml).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "src/routes/api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
